{
  "name": "ai_playwright",
  "private": true,
  "description": "Webship-js (Playwright + Cucumber) BDD suite for the AI Playwright Drupal module: drives a freshly installed site to prove the settings page, the status report and access control load with no PHP errors.",
  "license": "GPL-2.0",
  "engines": {
    "node": ">= 24.0",
    "yarn": ">= 4.18.1"
  },
  "packageManager": "yarn@4.18.1",
  "keywords": [
    "Drupal",
    "Figma",
    "Canvas",
    "AI"
  ],
  "author": "Rajab Natshah",
  "scripts": {
    "test": "node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:chromium": "BROWSER=chromium node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:firefox": "BROWSER=firefox node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:webkit": "BROWSER=webkit node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:headed": "HEADLESS=false node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "lint:js": "node ./node_modules/eslint/bin/eslint.js tests/step-definitions",
    "generate-reports": "generate-reports"
  },
  "devDependencies": {
    "@cucumber/pretty-formatter": "^3.3.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^8.0.0",
    "webship-js": "^2.0.0"
  },
  "resolutions": {
    "@cucumber/pretty-formatter": "^3.3"
  }
}
